<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Device-calendar integration (opt-in in Settings): read busy times so
         the planner schedules around life; write workouts as all-day events. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Coarse location for weather-aware outdoor sessions (optional). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Rest-timer haptics + reliable alerts even when backgrounded. Only the
         user-grantable SCHEDULE_EXACT_ALARM: USE_EXACT_ALARM is Play-restricted
         to alarm/calendar apps, and the timer already falls back to an inexact
         alarm when exact isn't granted (StrengthViewModel catches the
         SecurityException). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Keep the workout session alive (live timer) while the app is backgrounded.
         specialUse, not health: this service only shows a chronometer notification,
         it never reads a health sensor — "health" type wrongly required a Health
         Connect/activity-recognition runtime permission to already be granted just
         to START the timer, which crashed the app on first launch (fresh installs
         have none of those granted yet). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Health Connect read permissions -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Requested by HealthConnectManager — undeclared permissions are
         auto-denied by Health Connect, which made every manual sync fail. -->
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <!-- Body composition (smart scale): profile weight/body fat + the Body
         trends history. -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
    <!-- Morning readiness worker reads last night's sleep/HRV without the app
         in the foreground. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Lets the app open the Health Connect app to manage permissions (Android 13-). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- No auto-backup: it would copy the Supabase auth/refresh token to cloud
         backups; all real data lives server-side and restores on sign-in. -->
    <application
        android:name=".WorkoutMakerApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WorkoutMaker"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WorkoutMaker.Splash">
            <!-- Auth email links (confirm signup, password recovery) re-enter here. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="workoutmaker" android:host="auth" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect permissions rationale (Android 14+ built-in HC). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect permissions rationale (Android 13- via APK). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Rest-timer alarm receiver — alerts when a rest period ends. -->
        <receiver android:name=".notify.RestAlarmReceiver" android:exported="false" />

        <!-- Keeps a strength session alive with a live-timer notification. -->
        <service
            android:name=".work.WorkoutForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="workout-session-timer" />
        </service>

        <!-- Hilt provides the WorkManager factory; disable default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
